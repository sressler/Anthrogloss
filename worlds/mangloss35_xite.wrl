}
}
"
}
DEF ARMREACH_R_SCR Script {
eventIn SFBool isOver
eventIn SFBool isActive
eventOut SFColor bgColor
eventOut SFInt32 checkAndIndicatorChoice
field SFColor blue 0 0 .8
field SFColor green 0 .6 0
field SFBool isOn FALSE
url "javascript:
function initialize() {
bgColor = blue;
isOn = FALSE;
checkAndIndicatorChoice = -1;
}
function isOver(value,time) {
if(value)
bgColor = green;
else
bgColor = blue;
}
function isActive(value,time) {
if(value) {
if(isOn) {
isOn = FALSE;
checkAndIndicatorChoice = -1;
}
else {
isOn = TRUE;
checkAndIndicatorChoice = 0;
}
}
}
"
}
DEF SIGHTCONE_SCR Script {
eventIn SFBool isOver
eventIn SFBool isActive
eventOut SFColor bgColor
eventOut SFInt32 checkAndConeChoice
field SFColor blue 0 0 .8
field SFColor green 0 .6 0
field SFBool isOn FALSE
url "javascript:
function initialize() {
bgColor = blue;
isOn = FALSE;
checkAndConeChoice = -1;
}
function isOver(value,time) {
if(value)
bgColor = green;
else
bgColor = blue;
}
function isActive(value,time) {
if(value) {
if(isOn) {
isOn = FALSE;
checkAndConeChoice = -1;
}
else {
isOn = TRUE;
checkAndConeChoice = 0;
}
}
}
"
}
