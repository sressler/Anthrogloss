directOutput TRUE
url "javascript:
function select(i, time) {
  if (i === current) return;
  current = i;
  for (var j = 0; j < mats.length; j++) mats[j].diffuseColor = green;
  for (var k = 0; k < sws.length; k++) sws[k].whichChoice = -1;
  for (var j = 4 * i; j < 4 * i + 4; j++) mats[j].diffuseColor = red;
  sws[swOf[i]].whichChoice = fnVal[i];
}
"
}
