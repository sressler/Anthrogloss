DEF CISCR Script { # controls-icon script
eventIn SFBool isActive
eventOut SFInt32 ciChoice
eventOut SFInt32 cpChoice
url "javascript:
function initialize() {
ciChoice = 0;
cpChoice = -1;
}
function isActive(value,time) {
if(value) {
ciChoice = -1;
cpChoice = 0;
}
}
"
}
