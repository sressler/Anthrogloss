# end of "head-up display" stuff
DEF CLEARALL Script {
eventIn SFBool clearAll
eventOut SFColor allColor
field SFColor green 0 0.5 0
url "javascript:
function initialize () {
allColor = green;
}
function clearAll(value,time) {
if(value) {
allColor = green;
}
}
"
}
DEF CLEARFULLNAMES Script {
eventIn SFBool toClearfullnames
eventOut SFInt32 fullnameChoice
url "javascript:
function initialize() {
fullnameChoice = -1;
}
function toClearfullnames(value,time) {
if(value) fullnameChoice = -1;
}
"
}
