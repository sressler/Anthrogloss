# Two body-planes: sagittal plane (from J. A. Roebuck, Jr., _Anthropometric Methods:
# Designing to Fit the Human Body_, p. 22), and Frankfort plane (Roebuck p. 172).
# They are togglable from the controls-panel.
DEF SAGITTAL_SW Switch {
choice [
Shape {
appearance DEF GEOMETRY_APP Appearance {
material Material {
diffuseColor 0 0 .6
transparency .5
}
}
geometry IndexedFaceSet {
solid FALSE
coord Coordinate {
point [ .05 -27 25 .05 32 25 .05 32 -14 .05 -27 -14 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
DEF FRANKFORT_SW Switch {
choice [
Shape {
appearance USE GEOMETRY_APP
geometry IndexedFaceSet {
solid FALSE
coord Coordinate {
point [ -12.6 27.13 25 -12.6 25.09 -14 12.7 25.09 -14 12.7 27.13 25 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
# Touch-sensitive body-balls at anthropometric landmark points, and scripts.
Transform {
children [
DEF BBALLTS00 TouchSensor { }
DEF BBALLSW00 Switch {
choice [
Shape {
appearance Appearance {
material DEF BBALLMAT00 Material {
diffuseColor 0 .5 0
}
}
geometry Sphere { radius .2 }
}
Shape {
appearance Appearance {
material DEF BBALLMATL00 Material {
diffuseColor 0 .5 0
}
}
geometry Sphere { radius .26 }
}
]
}
]
translation 3.8 .2 -3.16
}
DEF SCR0_00 Script {
eventIn SFBool isOver
eventIn SFBool isActive
eventOut SFInt32 radiusChoice
eventOut SFInt32 sel
url "javascript:
function initialize () { radiusChoice = 0; }
function isOver(value,time) { radiusChoice = value ? 1 : 0; }
function isActive(value,time) { if (value) sel = 0; }
"
}
