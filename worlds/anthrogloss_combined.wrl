}
}
"
}
DEF ARMREACH_R_SCR Script {
eventIn SFBool isOver
eventIn SFBool isActive
eventOut SFColor bgColor
eventOut SFInt32 checkAndIndicatorChoice
field SFColor blue 0 0 .8
field SFColor green 0 .6 0
field SFBool isOn FALSE
url "javascript:
function initialize() {
bgColor = blue;
isOn = FALSE;
checkAndIndicatorChoice = -1;
}
function isOver(value,time) {
if(value)
bgColor = green;
else
bgColor = blue;
}
function isActive(value,time) {
if(value) {
if(isOn) {
isOn = FALSE;
checkAndIndicatorChoice = -1;
}
else {
isOn = TRUE;
checkAndIndicatorChoice = 0;
}
}
}
"
}
DEF SIGHTCONE_SCR Script {
eventIn SFBool isOver
eventIn SFBool isActive
eventOut SFColor bgColor
eventOut SFInt32 checkAndConeChoice
field SFColor blue 0 0 .8
field SFColor green 0 .6 0
field SFBool isOn FALSE
url "javascript:
function initialize() {
bgColor = blue;
isOn = FALSE;
checkAndConeChoice = -1;
}
function isOver(value,time) {
if(value)
bgColor = green;
else
bgColor = blue;
}
function isActive(value,time) {
if(value) {
if(isOn) {
isOn = FALSE;
checkAndConeChoice = -1;
}
else {
isOn = TRUE;
checkAndConeChoice = 0;
}
}
}
"
}
# Drag-reset button and script.  Clicking this button causes all the draggable
# things to return to their starting positions.
# Back-plate.
Shape {
appearance USE CI_DRAGRESET_BACKPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ -.04 -.055 -.15 -.0217 -.055 -.15 -.0217 -.0522 -.15 -.04 -.0522 -.15
] }
coordIndex [ 0 1 2 3 -1 ]
}
}
# "DRAG RESET".
Transform {
translation -.0398 -.0545 -.1499
children Shape {
appearance USE WTXT_APP
geometry Text {
fontStyle FontStyle {
family "SANS"
size 0.0027
}
string "DRAG RESET"
}
}
}
# Invisible touch-plate.
Group {
children [
DEF DRAGRESET_TS TouchSensor { }
Shape {
appearance USE INVISPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ -.04 -.055 -.1498 -.0217 -.055 -.1498 -.0217 -.0522 -.1498 -.04 -.0522
-.1498 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
# Body-reset button (added): animates back to the home view.
Shape {
appearance USE CI_DRAGRESET_BACKPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ -.0625 -.055 -.15 -.0442 -.055 -.15 -.0442 -.0522 -.15 -.0625 -.0522 -.15 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
Transform {
translation -.0623 -.0545 -.1499
children Shape {
appearance USE WTXT_APP
geometry Text {
fontStyle FontStyle {
family "SANS"
size 0.0027
}
string "BODY RESET"
}
}
}
Group {
children [
DEF BODYRESET_TS TouchSensor { }
Shape {
appearance USE INVISPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ -.0625 -.055 -.1498 -.0442 -.055 -.1498 -.0442 -.0522 -.1498 -.0625 -.0522 -.1498 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
DEF BODYRESET_SCR Script {
eventIn SFBool isActive
eventIn SFBool aBound
field SFBool aIsBound FALSE
field SFNode homeA USE HOME_A
field SFNode homeB USE HOME_B
directOutput TRUE
url "javascript:
function aBound(value, time) { aIsBound = value; }
function isActive(value, time) {
if (!value) return;
var a = aIsBound;
try { a = a || homeA.isBound; } catch (e) {}
if (a) homeB.set_bind = TRUE;
else homeA.set_bind = TRUE;
}
"
}
# Body-toggle button (added): switches between standing and seated man.
Shape {
appearance USE CI_DRAGRESET_BACKPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ -0.0125 -.055 -.15 0.0125 -.055 -.15 0.0125 -.0522 -.15 -0.0125 -.0522 -.15 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
Transform {
translation -0.0123 -.0545 -.1499
children Shape {
appearance USE WTXT_APP
geometry Text {
fontStyle FontStyle {
family "SANS"
size 0.0027
}
string "SHOW SEATED"
}
}
}
Group {
children [
DEF BODYTOGGLE_TS TouchSensor { }
Shape {
appearance USE INVISPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ -0.0125 -.055 -.1498 0.0125 -.055 -.1498 0.0125 -.0522 -.1498 -0.0125 -.0522 -.1498 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
DEF DRAGRESET_SCR Script {
eventIn SFBool isActive
eventOut SFVec3f resetTrans
eventOut SFVec3f resetLeft
eventOut SFVec3f resetRight
field SFVec3f zeroTrans 0 0 0
field SFVec3f leftHome 0.04271 -0.003044 0
field SFVec3f rightHome -0.048248 -0.004922 0
url "javascript:
function initialize() {
resetTrans = zeroTrans; resetLeft = leftHome; resetRight = rightHome;
}
function isActive(value,time) {
if (value) { resetTrans = zeroTrans; resetLeft = leftHome; resetRight = rightHome; }
}
"
}
