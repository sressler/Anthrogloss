} # end of wheelchair-in-switch.
# "Head-up display" stuff.
Collision {
collide FALSE
children [
DEF B_PS ProximitySensor { size 10000 10000 10000 }
DEF B_PST Transform {
children [
# Controls-icon: when clicked it becomes the control-panel.
DEF B_CISW Switch { # controls-icon switch
choice [
Group {
children [
# Back-plate behind "CONTROLS".
Shape {
appearance DEF B_CI_DRAGRESET_BACKPLATE_APP Appearance {
material Material {
diffuseColor 0 .6 0
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0215 -.055 -.15 .0501 -.055 -.15 .0501 -.05 -.15 .0215 -.05 -.15
] }
coordIndex [ 0 1 2 3 -1 ]
}
}
# "CONTROLS".
Transform {
translation .0219 -.0543 -.1499
children Shape {
appearance DEF B_WTXT_APP Appearance {
material Material {
diffuseColor 1 1 1
}
}
geometry Text {
fontStyle FontStyle {
family "SANS"
size 0.005000
}
string "CONTROLS"
}
}
}
# Invisible touch-plate in front of "CONTROLS".
Group {
children [
# controls-icon touch-sensor
DEF B_CITS TouchSensor { }
Shape {
appearance DEF B_INVISPLATE_APP Appearance {
material Material {
diffuseColor 0 0 0
transparency 1
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0215 -.055 -.1498 .0501 -.055 -.1498 .0501 -.05 -.1498 .0215 -.05
-.1498 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
]
}
]
}
DEF B_CISCR Script { # controls-icon script
eventIn SFBool isActive
eventOut SFInt32 ciChoice
eventOut SFInt32 cpChoice
url "javascript:
function initialize() {
ciChoice = 0;
cpChoice = -1;
}
function isActive(value,time) {
if(value) {
ciChoice = -1;
cpChoice = 0;
}
}
"
}
# Controls-panel, produced when controls-icon is clicked; the controls
# consist of toggles for the body-planes and for the wheelchair.  Panel is draggable.
DEF B_CPSW Switch { # controls-panel switch
choice [
Group {
children [
DEF B_CP_DRAG PlaneSensor {
autoOffset FALSE
minPosition -1. -1.
maxPosition 1. 1.
}
DEF B_CP_TRANSFORM Transform {
children [
Transform {
# Overall translation for controls-panel.
translation 0. .007 0.
children [
# Solid rectangle that will show as border (z = -.1499)
Shape {
appearance Appearance {
material Material {
diffuseColor 0 0 .6
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0281 -.0623 -.1499 .049 -.0623 -.1499 .049 -.027 -.1499 .0281 -.027
-.1499 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
# "iconify" clickable thing in top right of border:
#   "iconify" text (z = -.1498)
Transform {
translation .0415 -.0291 -.1498
children Shape {
appearance Appearance {
material DEF B_ICONIFY_MAT Material {
diffuseColor 0 .7 0
}
}
geometry Text {
fontStyle FontStyle {
family "SANS"
size .0025
}
string "iconify"
}
}
}
# Invisible touch-plate (z = -.1497)
Group {
children [
DEF B_ICONIFY_TS TouchSensor { }
Shape {
appearance USE B_INVISPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ .0413 -.03 -.1497 .049 -.03 -.1497 .049 -.027 -.1497 .0413 -.027 -.1497
] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
# Smaller solid rectangle that will be background of interior (z = -.1498)
Shape {
appearance Appearance {
material Material {
diffuseColor 0 0 .4
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0291 -.0613 -.1498 .048 -.0613 -.1498 .048 -.03 -.1498 .0291 -.03
-.1498 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
# Texts of "planes:" and of the plane-names (z = -.1497),
# and clickable check-things.
Transform {
translation .0301 -.033 -.1497
children Shape {
appearance USE B_WTXT_APP
geometry Text {
fontStyle DEF B_CP_INT_FS FontStyle {
family "SANS"
size .003
}
string "planes:"
}
}
}
Transform {
translation .0341 -.0365 -.1497
children Shape {
appearance USE B_WTXT_APP
geometry Text {
fontStyle USE B_CP_INT_FS
string "sagittal"
}
}
}
# check-thing for sagittal
Transform {
translation .0316 -.0365 -.1497
children [
# background square
Shape {
appearance Appearance {
material DEF B_SAGITTAL_BG_MAT Material {
diffuseColor 0 0 .8
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ 0 0 0 .002 0 0 .002 .002 0 0 .002 0 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
# check
DEF B_SAGITTAL_CHECK_SW Switch {
choice [
Shape {
appearance Appearance {
material Material {
diffuseColor 1 1 1
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0002 .0008 .0001 .0008 .0002 .0001 .0008 .0004 .0001 .0002 .001 .0001
.0018 .0016 .0001 .0018 .0018 .0001 ] }
coordIndex [ 0 1 2 3 -1 1 4 5 2 -1 ]
}
}
]
}
# invis. touch-plate
Group {
children [
DEF B_SAGITTAL_CHECK_TS TouchSensor { }
Shape {
appearance USE B_INVISPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ 0 0 .0002 .002 0 .0002 .002 .002 .0002 0 .002 .0002 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
]
}
Transform {
translation .0341 -.04 -.1497
children Shape {
appearance USE B_WTXT_APP
geometry Text {
fontStyle USE B_CP_INT_FS
string "Frankfort"
}
}
}
# check-thing for Frankfort
Transform {
translation .0316 -.04 -.1497
children [
# background square
Shape {
appearance Appearance {
material DEF B_FRANKFORT_BG_MAT Material {
diffuseColor 0 0 .8
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ 0 0 0 .002 0 0 .002 .002 0 0 .002 0 ] }
coordIndex [ 0 1 2 3 -1 ]
}
