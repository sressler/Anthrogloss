# end of standing man.
# Three mutually perpendicular body-planes (from J. A. Roebuck, Jr., _Anthropometric Methods:
# Designing to Fit the Human Body_, p. 22), and the Frankfort plane (Roebuck p. 172).
# They are togglable from the controls-panel.
DEF SAGITTAL_SW Switch {
choice [
Shape {
appearance DEF GEOMETRY_APP Appearance {
material Material {
diffuseColor 0 0 .6
transparency .5
}
}
geometry IndexedFaceSet {
solid FALSE
coord Coordinate {
point [ 0 -38 10 0 39 10 0 39 -10 0 -38 -10 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
DEF CORONAL_SW Switch {
choice [
Shape {
appearance USE GEOMETRY_APP
geometry IndexedFaceSet {
solid FALSE
coord Coordinate {
point [ -17.5 -38 0 -17.5 39 0 15.7 39 0 15.7 -38 0 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
DEF TRANSVERSE_SW Switch {
choice [
Shape {
appearance USE GEOMETRY_APP
geometry IndexedFaceSet {
solid FALSE
coord Coordinate {
point [ -17.5 6 10 -17.5 6 -10 15.7 6 -10 15.7 6 10 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
DEF FRANKFORT_SW Switch {
choice [
Shape {
appearance USE GEOMETRY_APP
geometry IndexedFaceSet {
solid FALSE
coord Coordinate {
point [ -17.5 33.38 10 -17.5 31.34 -10 15.7 31.34 -10 15.7 33.38 10 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
# end of body-planes
# Touch-sensitive body-balls at anthropometric landmark points, and scripts.
Transform {
children [
DEF BBALLTS00 TouchSensor { }
DEF BBALLSW00 Switch {
choice [
Shape {
appearance Appearance {
material DEF BBALLMAT00 Material {
diffuseColor 0 .5 0
}
}
geometry Sphere { radius .2 }
}
Shape {
appearance Appearance {
material DEF BBALLMATL00 Material {
diffuseColor 0 .5 0
}
}
geometry Sphere { radius .26 }
}
]
}
]
translation 3.609400 6.25 3.
}
DEF SCR0_00 Script {
eventIn SFBool isOver
eventIn SFBool isActive
eventOut SFInt32 radiusChoice
eventOut SFInt32 sel
url "javascript:
function initialize () { radiusChoice = 0; }
function isOver(value,time) { radiusChoice = value ? 1 : 0; }
function isActive(value,time) { if (value) sel = 0; }
"
}
