DEF B_CPSCR Script { # controls-panel script (for "iconify" toggler)
eventIn SFBool isOver
eventIn SFBool isActive
eventOut SFColor textColor
eventOut SFInt32 ciChoice
eventOut SFInt32 cpChoice
field SFColor darkGreen 0 .7 0
field SFColor brightGreen 0 1. 0
url "javascript:
function initialize() {
textColor = darkGreen;
ciChoice = 0;
cpChoice = -1;
}
function isOver(value,time) {
if(value)
textColor = brightGreen;
else
textColor = darkGreen;
}
function isActive(value,time) {
if(value) {
ciChoice = 0;
cpChoice = -1;
}
}
"
}
# Scripts for check-things of togglers of body-planes, arm-reach-indicators,
# sight cone, and wheelchair.
DEF B_SAGITTAL_SCR Script {
eventIn SFBool isOver
eventIn SFBool isActive
eventOut SFColor bgColor
eventOut SFInt32 checkAndPlaneChoice
field SFColor blue 0 0 .8
field SFColor green 0 .6 0
field SFBool isOn FALSE
url "javascript:
function initialize() {
bgColor = blue;
isOn = FALSE;
checkAndPlaneChoice = -1;
}
function isOver(value,time) {
if(value)
bgColor = green;
else
bgColor = blue;
}
function isActive(value,time) {
if(value) {
if(isOn) {
isOn = FALSE;
checkAndPlaneChoice = -1;
}
else {
isOn = TRUE;
checkAndPlaneChoice = 0;
}
}
}
"
}
