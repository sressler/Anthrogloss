# Drag-reset button and script.  Clicking this button causes all the draggable
# things to return to their starting positions.
# Back-plate.
Shape {
appearance USE B_CI_DRAGRESET_BACKPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ -.04 -.055 -.15 -.0217 -.055 -.15 -.0217 -.0522 -.15 -.04 -.0522 -.15
] }
coordIndex [ 0 1 2 3 -1 ]
}
}
# "DRAG RESET".
Transform {
translation -.0398 -.0545 -.1499
children Shape {
appearance USE B_WTXT_APP
geometry Text {
fontStyle FontStyle {
family "SANS"
size 0.0027
}
string "DRAG RESET"
}
}
}
# Invisible touch-plate.
