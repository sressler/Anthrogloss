# "Head-up display" stuff.
Collision {
collide FALSE
children [
DEF PS ProximitySensor { size 10000 10000 10000 }
DEF PST Transform {
children [
# Controls-icon: when clicked it becomes the control-panel.
DEF CISW Switch { # controls-icon switch
choice [
Group {
children [
# Back-plate behind "CONTROLS".
Shape {
appearance DEF CI_DRAGRESET_BACKPLATE_APP Appearance {
material Material {
diffuseColor 0 .6 0
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0215 -.055 -.15 .0501 -.055 -.15 .0501 -.05 -.15 .0215 -.05 -.15
] }
coordIndex [ 0 1 2 3 -1 ]
}
}
# "CONTROLS".
Transform {
translation .0219 -.0543 -.1499
children Shape {
appearance DEF WTXT_APP Appearance {
material Material {
diffuseColor 1 1 1
}
}
geometry Text {
fontStyle FontStyle {
family "SANS"
size 0.005000
}
string "CONTROLS"
}
}
}
# Invisible touch-plate in front of "CONTROLS".
Group {
children [
# controls-icon touch-sensor
DEF CITS TouchSensor { }
Shape {
appearance DEF INVISPLATE_APP Appearance {
material Material {
diffuseColor 0 0 0
transparency 1
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0215 -.055 -.1498 .0501 -.055 -.1498 .0501 -.05 -.1498 .0215 -.05
-.1498 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
]
}
]
}
DEF CISCR Script { # controls-icon script
eventIn SFBool isActive
eventOut SFInt32 ciChoice
eventOut SFInt32 cpChoice
url "javascript:
function initialize() {
ciChoice = 0;
cpChoice = -1;
}
function isActive(value,time) {
if(value) {
ciChoice = -1;
cpChoice = 0;
}
}
"
}
# Controls-panel, produced when controls-icon is clicked; the controls
# consist of toggles for the body-planes.  Panel is draggable.
DEF CPSW Switch { # controls-panel switch
choice [
Group {
children [
DEF CP_DRAG PlaneSensor {
autoOffset FALSE
minPosition -1. -1.
maxPosition 1. 1.
}
DEF CP_TRANSFORM Transform {
children [
Transform {
# Overall translation for controls-panel.
translation 0. .011 0.
children [
# Solid rectangle that will show as border (z = -.1499)
Shape {
appearance Appearance {
material Material {
diffuseColor 0 0 .6
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0281 -.0663 -.1499 .0501 -.0663 -.1499 .0501 -.027 -.1499 .0281 -.027
-.1499 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
# "iconify" clickable thing in top right of border:
#   "iconify" text (z = -.1498)
Transform {
translation .0426 -.0291 -.1498
children Shape {
appearance Appearance {
material DEF ICONIFY_MAT Material {
diffuseColor 0 .7 0
}
}
geometry Text {
fontStyle FontStyle {
family "SANS"
size .0025
}
string "iconify"
}
}
}
# Invisible touch-plate (z = -.1497)
Group {
children [
DEF ICONIFY_TS TouchSensor { }
Shape {
appearance USE INVISPLATE_APP
geometry IndexedFaceSet {
coord Coordinate {
point [ .0424 -.03 -.1497 .0501 -.03 -.1497 .0501 -.027 -.1497 .0424 -.027
-.1497 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
]
}
# Smaller solid rectangle that will be background of interior (z = -.1498)
Shape {
appearance Appearance {
material Material {
diffuseColor 0 0 .4
}
}
geometry IndexedFaceSet {
coord Coordinate {
point [ .0291 -.0653 -.1498 .0491 -.0653 -.1498 .0491 -.03 -.1498 .0291 -.03
-.1498 ] }
coordIndex [ 0 1 2 3 -1 ]
}
}
